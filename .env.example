# ─────────────────────────────────────────────────────────────
# AeroReclaim Dashboard — Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Notion ────────────────────────────────────────────────────
# Integration Token: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Task Tracker database ID
NOTION_DATABASE_ID=abb1607fb6b0460782fc0d268a7ce21f

# Commands database ID (optional)
# COMMANDS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Basic Auth (protects the dashboard) ───────────────────────
BASIC_AUTH_USER=aeroreclaim
BASIC_AUTH_PASSWORD=cambia-esto-por-una-contraseña-larga

# ── Google Sheets — Case Tracker (optional) ───────────────────
# Sheet ID: <id del Sheet central>
# API Key: https://console.cloud.google.com → Credentials
# El Sheet NO debe ser público: el dashboard lo lee vía GAS_CASES_ENDPOINT,
# que exige la clave GAS_CASES_ENDPOINT_KEY (misma que la propiedad del
# script CASES_ENDPOINT_KEY en Apps Script)
# GAS_CASES_ENDPOINT=https://script.google.com/macros/s/<id>/exec
# GAS_CASES_ENDPOINT_KEY=xxxxxxxx
# GOOGLE_SHEETS_SPREADSHEET_ID=xxxxxxxx
# GOOGLE_SHEETS_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
